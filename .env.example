# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# --- Graph store ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Ollama (host-native, never containerised) ---
OLLAMA_URL=http://localhost:11434

LLM_SYNTHESIS=qwen3.5:9b

# Extraction runs at ingest time only and is not latency-sensitive. Prefer capability over speed; a large model that partially offloads is acceptable.
LLM_EXTRACTION=gemma4

# The judge runs only under `akg eval` and MUST differ from LLM_SYNTHESIS. A model cannot independently grade its own output.
LLM_JUDGE=gemma4

# --- Ingestion ---
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval and verification ---
TOP_K=5
CHUNK_CHARS=400
CITATION_SIM_THRESHOLD=0.55

ENTAILMENT_ENABLED=0
ENTAILMENT_MODEL=cross-encoder/nli-deberta-v3-base

# --- Messaging interface ---
TELEGRAM_BOT_TOKEN=

# Chat ids allowed to use the bot, comma separated. EMPTY DENIES EVERYONE.
TELEGRAM_ALLOWED_CHATS=

# The bot writes to its own collection, never to QDRANT_COLLECTION, so that material sent at runtime cannot change what the gold set is measured against.
TELEGRAM_COLLECTION=chunks_live
TELEGRAM_INCOMING_DIR=var/telegram
